{
  "name": "estate-website",
  "compatibility_date": "2026-08-27",
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Without this, the asset router answers /api/* with the 404 page and the
    // Worker never runs. These paths must hit the Worker first.
    "run_worker_first": ["/api/*"]
  },
  // Feed cache + rotating access token.
  "kv_namespaces": [
    { "binding": "IG", "id": "1bd6949b84214112865af76486fc2dfc" }
  ],
  // Nightly at 4:17am Sydney (18:17 UTC): refresh the posts and renew the token.
  "triggers": {
    "crons": ["17 18 * * *"]
  }

  // SECRETS — never in this file. Add in the Cloudflare dashboard under
  // Settings → Variables and Secrets, choosing type "Secret" (not Variable,
  // which gets overwritten on deploy):
  //   IG_TOKEN        the IG... access token from Meta
  //   IG_REFRESH_KEY  any phrase you invent, for the manual refresh URL
}
